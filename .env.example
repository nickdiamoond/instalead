APIFY_API_TOKEN=your_token_here
# Instagram cookies for crawlerbros/instagram-keyword-search-scraper (Step 1 discovery_mode=cookie_keywords; scripts/test_cookie_keyword_search.py).
# One line: Cookie-Editor JSON array (instagram rows only is fine) or header: sessionid=...; ds_user_id=...; csrftoken=...
# Broken JSON from ``rur`` is auto-stripped before parse (see src/instagram_cookie_search.py).
INSTAGRAM_SESSION_COOKIE=
DEEPSEEK_API_KEY=your_deepseek_key_here
NEXARA_API_KEY=your_nexara_key_here
SHERLOCK_API_KEY=your_sherlock_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: max wait (seconds) for Step 2 manual inline confirm and scripts/test_telegram_callback_buttons.py.
# Omit or leave unset to wait indefinitely until someone taps a button.
# TELEGRAM_CALLBACK_TEST_TIMEOUT_SEC=3600
